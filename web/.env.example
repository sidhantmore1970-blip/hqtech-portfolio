# Web (Vite) environment variables
# For local development:  create a file called .env.local in web/
# For Vercel production:  add these in Vercel Dashboard → Project → Settings → Environment Variables

# Full URL to your deployed API (no trailing slash)
VITE_API_URL=https://your-api.up.railway.app/api

# For local dev only (Vercel uses the variable above):
# VITE_API_URL=http://localhost:3001/api
